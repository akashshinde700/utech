# --- Database ---
DATABASE_URL="mysql://root:password@localhost:3306/utech_erp"

# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-please-use-a-strong-random-string
JWT_EXPIRES_IN=1d
REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# --- OTP / Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="UTech ERP <noreply@utech.local>"

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
