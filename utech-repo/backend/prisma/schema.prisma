//  BATCH MANUFACTURING + SHIFT MANAGEMENT
// ============================================================

model Shift {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  name        String
  startTime   String // "06:00"
  endTime     String // "14:00"
  isActive    Boolean           @default(true)
  productions ProductionBatch[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ProductionBatch {
  id                   Int                  @id @default(autoincrement())
  number               String               @unique
  date                 DateTime
  shiftId              Int
  shift                Shift                @relation(fields: [shiftId], references: [id])
  jobcardId            Int?
  jobcard              Jobcard?             @relation(fields: [jobcardId], references: [id])
  itemId               Int
  item                 Item                 @relation("ItemProductionBatches", fields: [itemId], references: [id])
  bomId                Int?
  bom                  Bom?                 @relation(fields: [bomId], references: [id])
  status               String               @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  qtyPlanned           Decimal              @default(0.000) @db.Decimal(14, 3)
  qtyProduced          Decimal              @default(0.000) @db.Decimal(14, 3)
  qtyRejected          Decimal              @default(0.000) @db.Decimal(14, 3)
  startTime            DateTime?
  endTime              DateTime?
  machineId            Int?
  machine              Machine?             @relation(fields: [machineId], references: [id])
  notes                String?              @db.Text
  materialConsumptions ProductionMaterial[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([shiftId])
  @@index([jobcardId])
  @@index([itemId])
  @@index([status])
  @@index([date])
}

model ProductionMaterial {
  id          Int             @id @default(autoincrement())
  batchId     Int
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId      Int
  item        Item            @relation("ItemProductionMaterials", fields: [itemId], references: [id])
  qtyPlanned  Decimal         @default(0.000) @db.Decimal(14, 3)
  qtyConsumed Decimal         @default(0.000) @db.Decimal(14, 3)
  uomCode     String?
  notes       String?
}

// Centralized, race-free document numbering (used by utils/numbering.js).
// One row per `${prefix}-${yy}` (or code-prefix) key; the row is incremented
// inside the caller's transaction with a row lock (SELECT ... FOR UPDATE), so
// two concurrent documents can never draw the same number.
model NumberSequence {
  id      Int    @id @default(autoincrement())
  key     String @unique
  current Int    @default(0)
}
