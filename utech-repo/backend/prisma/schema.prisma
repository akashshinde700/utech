// ============================================================
//  STUBS — purchase / quality / project / files / audit
// ============================================================

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              Int                 @id @default(autoincrement())
  number          String              @unique
  date            DateTime
  expectedDate    DateTime?
  partyId         Int
  party           Party               @relation("PartyPurchaseOrders", fields: [partyId], references: [id])
  status          PurchaseStatus      @default(DRAFT)
  subtotal        Decimal             @default(0.00) @db.Decimal(14, 2)
  gstTotal        Decimal             @default(0.00) @db.Decimal(14, 2)
  total           Decimal             @default(0.00) @db.Decimal(14, 2)
  notes           String?
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?
  lines           PurchaseOrderLine[]
  grns            GRN[]
  purchaseReturns PurchaseReturn[]
  vendorWorkOrder VendorWorkOrder?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([partyId])
  @@index([status])
}

model PurchaseOrderLine {
  id          Int           @id @default(autoincrement())
  poId        Int
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  // nullable: work outsourced to a vendor is frequently a one-off, non-catalog
  // part identified only by a drawing/description, with no Item master row
  itemId      Int?
  item        Item?         @relation("ItemPOLines", fields: [itemId], references: [id])
  description String?
  qty         Decimal       @db.Decimal(14, 3)
  qtyReceived Decimal       @default(0.000) @db.Decimal(14, 3)
  rate        Decimal       @db.Decimal(14, 2)
  gstRate     Decimal       @default(18.00) @db.Decimal(5, 2)
  amount      Decimal       @db.Decimal(14, 2)
}

model GRN {
  id              Int              @id @default(autoincrement())
  number          String           @unique
  date            DateTime
  poId            Int?
  po              PurchaseOrder?   @relation(fields: [poId], references: [id])
  partyId         Int?
  party           Party?           @relation("PartyGRNs", fields: [partyId], references: [id])
  status          String           @default("PENDING") // PENDING | ACCEPTED | REJECTED | CANCELLED
  vehicleNo       String?
  notes           String?
  cancelReason    String?          @db.Text
  lines           GrnLine[]
  purchaseReturns PurchaseReturn[]

  // set when this receipt books in parts returned by an external vendor under a
  // VendorWorkOrder — receiving here is what advances that work order
  vendorWorkOrderId Int?
  vendorWorkOrder   VendorWorkOrder? @relation(fields: [vendorWorkOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poId])
  @@index([vendorWorkOrderId])
}

model GrnLine {
  id                    Int                  @id @default(autoincrement())
  grnId                 Int
  grn                   GRN                  @relation(fields: [grnId], references: [id], onDelete: Cascade)
  // nullable for the same reason as PurchaseOrderLine.itemId — a vendor-made
  // one-off part has no Item master row, and therefore no stock position
  itemId                Int?
  item                  Item?                @relation("ItemGRNLines", fields: [itemId], references: [id])
  description           String? // free-text label, used when itemId is null
  poLineId              Int?
  // receipt line -> vendor work order line, so returns roll straight back up
  vendorWorkOrderLineId Int?
  vendorWorkOrderLine   VendorWorkOrderLine? @relation(fields: [vendorWorkOrderLineId], references: [id])
  qty                   Decimal              @db.Decimal(14, 3)
  qtyAccepted           Decimal              @default(0.000) @db.Decimal(14, 3)
  qtyRejected           Decimal              @default(0.000) @db.Decimal(14, 3)
  rate                  Decimal?             @db.Decimal(14, 2)
  notes                 String?

  @@index([vendorWorkOrderLineId])
}

// ============================================================
//  VENDOR DEVELOPMENT — work outsourced outside the company
// ============================================================

enum VendorWorkOrderStatus {
  DRAFT
  SENT
  PARTIAL_RECEIVED
  RECEIVED
  SHORT_CLOSED
  CANCELLED
}

// The Project Engineer assigns a project document to a department; when that
// department (in practice Vendor Development) cannot do the work in-house it
// hands the scope to an external vendor. This model is that hand-off: it
// answers "when did it go out, who did we give it to, and did it come back".
//
// It is deliberately a *tracker*, not a stock document — a vendor very often
// manufactures from its own raw material, so there is nothing to move. Stock is
// always moved by exactly one linked document instead:
//   - material issued to the vendor  -> jobworkChallan (stock OUT)
//   - finished parts received back    -> grns          (stock IN)
// and once poId is set, GRN is the only way quantities can be received, so the
// tracker and the stock documents can never drift apart.
model VendorWorkOrder {
  id     Int    @id @default(autoincrement())
  number String @unique // VWO-26-00001

  // --- where the work came from ---
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
  jobcardId    Int?
  jobcard      Jobcard?    @relation(fields: [jobcardId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  // --- who it went out to ---
  partyId Int
  party   Party @relation("PartyVendorWorkOrders", fields: [partyId], references: [id])

  status VendorWorkOrderStatus @default(DRAFT)

  date               DateTime // raised on
  sentDate           DateTime? // handed to the vendor on
  expectedReturnDate DateTime?
  actualReturnDate   DateTime? // fully returned on

  scopeDescription String? @db.Text
  instructions     String? @db.Text
  notes            String? @db.Text
  closureRemarks   String? @db.Text // why it was short closed / cancelled

  // --- linked documents ---
  materialIssued   Boolean         @default(false)
  jobworkChallanId Int?            @unique
  jobworkChallan   JobworkChallan? @relation(fields: [jobworkChallanId], references: [id])
  poId             Int?            @unique
  po               PurchaseOrder?  @relation(fields: [poId], references: [id])
  grns             GRN[]

  // bare ids, matching PurchaseOrder.approvedById — the named activity trail
  // comes from AuditLog(entity="VendorWorkOrder"), which already joins the user
  createdById Int?
  sentById    Int?

  lines VendorWorkOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partyId])
  @@index([status])
  @@index([assignmentId])
  @@index([jobcardId])
  @@index([departmentId])
}

model VendorWorkOrderLine {
  id                Int             @id @default(autoincrement())
  vendorWorkOrderId Int
  vendorWorkOrder   VendorWorkOrder @relation(fields: [vendorWorkOrderId], references: [id], onDelete: Cascade)

  itemId        Int? // optional catalog link — outsourced parts often aren't catalog items
  item          Item?   @relation("ItemVendorWorkOrderLines", fields: [itemId], references: [id])
  description   String? // free-text label, required when itemId is null
  drawingNumber String?
  partNumber    String?

  qtySent     Decimal  @db.Decimal(14, 3)
  qtyReceived Decimal  @default(0.000) @db.Decimal(14, 3)
  qtyRejected Decimal  @default(0.000) @db.Decimal(14, 3)
  uomCode     String?
  rate        Decimal? @db.Decimal(14, 2)
  gstRate     Decimal  @default(18.00) @db.Decimal(5, 2)
  notes       String?

  // bare id (no FK) exactly like GrnLine.poLineId — PurchaseOrder edits replace
  // their lines wholesale, so a hard constraint here would block them
  poLineId Int?

  grnLines GrnLine[]

  @@index([vendorWorkOrderId])
  @@index([itemId])
}

model QualityCheck {
  id            Int                @id @default(autoincrement())
  number        String             @unique
  date          DateTime
  refType       String // "GRN" | "JOBCARD" | "DISPATCH"
  refId         Int
  result        String             @default("PENDING") // PASS | FAIL | PENDING
  inspectorName String?
  remarks       String?            @db.Text
