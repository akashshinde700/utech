model Expense {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  date        DateTime
  category    String // "Travel" | "Salary" | "Material" | "Utility" | "Other"
  partyId     Int?
  party       Party?   @relation("PartyExpenses", fields: [partyId], references: [id])
  description String
  amount      Decimal  @db.Decimal(14, 2)
  taxAmount   Decimal  @default(0.00) @db.Decimal(14, 2)
  paymentMode String   @default("CASH") // CASH | BANK | UPI | CHEQUE
  reference   String?
  notes       String?  @db.Text
  createdById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([partyId])
}

model Project {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  name      String
  partyId   Int?
  budget    Decimal?      @db.Decimal(14, 2)
  startDate DateTime?
  endDate   DateTime?
  status    String        @default("PLANNED")
