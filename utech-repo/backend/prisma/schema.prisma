model Attachment {
  id           Int      @id @default(autoincrement())
  refType      String // "JOBCARD" | "INVOICE" | "DISPATCH" etc.
  refId        Int
  lineId       Int? // optional: ties attachment to a specific line (e.g. JobcardLine) within the ref record
  category     String? // optional project-level doc category e.g. "ASSEMBLY" | "SUBASSEMBLY" | "SUBPART"
  filename     String
  storedName   String
  mimeType     String
  size         Int
  uploadedById Int?
  createdAt    DateTime @default(now())

  assignments Assignment[]

  @@index([refType, refId])
  @@index([lineId])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REOPENED
  CANCELLED
}

// document/page-level delegation on top of an uploaded Attachment — separate
// from Jobcard.assignedOperatorId/projectEngineerId, which remain simple
// whole-jobcard ownership markers. Works for any assignee role generically
// (Department Head, Operator, or a Vendor/External Developer role created via
// the Role Master), with zero hardcoded role-name branching.
//
// departmentId/departmentSubCategoryId capture the selection criteria used at
// assignment time (so department-wise/subcategory-wise dashboards can group
// directly on this table, and history stays accurate even if the assigned
// user's own department changes later) — the actual work target is always a
// specific assignedToId user.
model Assignment {
  id Int @id @default(autoincrement())

  attachmentId Int
  attachment   Attachment @relation(fields: [attachmentId], references: [id])
  pageNumbers  Json? // nullable array of page numbers e.g. [3,4,5]; null/empty = whole document

  departmentId            Int?
  department              Department?            @relation(fields: [departmentId], references: [id])
  departmentSubCategoryId Int?
  departmentSubCategory   DepartmentSubCategory? @relation(fields: [departmentSubCategoryId], references: [id])

  assignedById Int
  assignedBy   User @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  assignedToId Int
  assignedTo   User @relation("AssignmentAssignedTo", fields: [assignedToId], references: [id])

  instructions String?          @db.Text
  priority     JobcardPriority  @default(MEDIUM)
  dueDate      DateTime?
  status       AssignmentStatus @default(ASSIGNED)

  assignedAt  DateTime  @default(now())
  startedAt   DateTime?
  startNotes  String?   @db.Text // e.g. which external vendor it was sent to, and when
  completedAt DateTime?

  completedById     Int?
  completedBy       User?   @relation("AssignmentCompletedBy", fields: [completedById], references: [id])
  completionRemarks String? @db.Text

  // work on this assignment that was handed to an external vendor
  vendorWorkOrders VendorWorkOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attachmentId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([departmentId])
  @@index([departmentSubCategoryId])
  @@index([status])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int?
  payload   String?  @db.Text
